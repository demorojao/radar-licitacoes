# Copie para web/.env.local (fora do Git) para rodar o site na sua máquina.
# Na Vercel, as mesmas variáveis ficam em Settings → Environment Variables.

# Endereço do projeto no Supabase (Project Settings → API ou botão "Connect").
SUPABASE_URL=https://acwwonpwaiegobvcawvw.supabase.co

# Chave PÚBLICA (publishable, começa com sb_publishable_). Ela só permite o que o RLS libera:
# ler. Nunca coloque aqui a senha do banco nem a chave secreta (sb_secret_).
SUPABASE_PUBLISHABLE_KEY=
